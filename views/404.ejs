<!DOCTYPE html>
<html>
<head>
  <title>Page Not Found</title>
  <%- include('partials/head') %>
</head>
<script defer>

  document.addEventListener("DOMContentLoaded", () => {
      topNavBar()
      bottomNavBar()
  });
    
</script>
<style>
  /* Reset basic layout */

  /* Main container */
  .error-page {
    display: grid;
    place-items: center;
    background-image: url('https://image.tmdb.org/t/p/original/3nv2TEz2u178xPXzdKlZdUh5uOI.jpg');
    background-size: cover;
    background-position: center;
    position: absolute;
    top: 0;
    min-height: 100dvh;
    width: 100%;
    padding-bottom: unset !important;
  }

  /* Inner content */
  .container {
    width: 100%;
    height: 100%;
    padding: 20px;
    text-align: center;
    display: grid;
    gap: 16px;
    place-content: center;
    backdrop-filter: brightness(0.4);
  }

  /* 404 label */
  .code {
    font-size: 16px;
    font-weight: 600;
    color: #818cf8;
  }

  /* Title */
  .title {
    font-size: 72px;
    font-weight: 600;
    color: var(--font-color1);
    letter-spacing: -6px;
    line-height: 72px;
  }
  
  /* Larger screens */
  @media (max-width: 640px) {
    .title {
      font-size: 48px;
      letter-spacing: -4px;
      line-height: 48px;
    }
  }

  /* Description */
  .description {
    font-size: 16px;
    color: var(--font-color3);
  }

  /* Buttons container */
  .actions-404 {
    display: flex;
    justify-content: center;
    gap: 12px;
    align-items: center;
  }

  /* Primary button */
  .btn {
    display: flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    background-color: var(--color5);
    color: var(--font-color1);
    padding: 10px 14px;
    font-size: 14px;
    font-weight: 600;
    border-radius: var(--brad8);
    text-decoration: none;
    transition: background 0.2s ease;
    cursor: pointer;
  }

  .btn-primary:hover {
    background-color: var(--color3); /* indigo-400 */
  }

  .btn-primary span {
    margin-right: 4px;
  }
</style>
<body>
  <nav id="top-bar"></nav>
	<main class="error-page">
    <div class="container">
      <p class="code">404</p>

      <h1 class="title">
        Page not found
      </h1>

      <p class="description">
        Sorry, we couldn’t find the page you’re looking for.
      </p>

      <div class="actions-404">
        <a onclick=history.back() class="btn"><i class="fa-solid fa-arrow-left"></i>Go back</a>
        <a href="/" class="btn"><i class="fa-solid fa-house"></i>Home</a>
      </div>
    </div>
  </main>
	<nav id="bottom-bar"></nav>

</body>

</html>