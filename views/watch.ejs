<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" type="text/css" href="/watch/styles.css">
    <link rel="stylesheet" type="text/css" href="/watch/media.css">    
    <script src="/watch/watch.js" defer></script>
    
</head>

<script defer>

    const name =  `<%= name %>`.replace(/&amp;/g, '&')
                .replace(/&lt;/g, '<')
                .replace(/&gt;/g, '>')
                .replace(/&quot;/g, '"')
                .replace(/&#039;/g, "'");

    let tvData = null;

    if ( `<%= mediaType %>` == "tv" ) {
        tvData = { season : `<%= season %>`, episode : `<%= episode %>`, epname : ``}
    };

    document.addEventListener("DOMContentLoaded", () => {
        loadWatchPage(`<%= mediaType %>`, name, `<%= id %>`, tvData);
    });
    
</script>

<body>
    <header id="header"></header>    
    <main id="main-content">  
    </main>
    <nav class="bottom-bar"></nav>
</body>
</html>
