<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/watch/styles.css" type="text/css">
    <link rel="stylesheet" href="/watch/media.css" media="(max-width: 767px)" type="text/css">
    <script src="/watch/watch.js" defer></script>
    
</head>

<script defer>

    const name =  `<%= name %>`.replace(/&amp;/g, '&')
                .replace(/&lt;/g, '<')
                .replace(/&gt;/g, '>')
                .replace(/&quot;/g, '"')
                .replace(/&#039;/g, "'");

    let tvData = null;

    if ( `<%= mediaType %>` == "tv" ) {
        tvData = { season : `<%= season %>`, episode : `<%= episode %>`, epname : ``}
    };

    // window.onload = function () {
    //     topNavBar()
    //     bottomNavBar()
    //     setUpScrollEvents()
    // }

    document.addEventListener("DOMContentLoaded", () => {
        topNavBar()
        bottomNavBar()
        setUpScrollEvents()
        loadWatchPage(`<%= mediaType %>`, name, `<%= id %>`, tvData);
    });
    
</script>

<body>
    <nav id="top-bar"></nav>
    <main id="main-content">  
    </main>
    <nav id="bottom-bar"></nav>
</body>
</html>
