<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>

<script defer>

    const name =  `<%= name %>`.replace(/&amp;/g, '&')
                .replace(/&lt;/g, '<')
                .replace(/&gt;/g, '>')
                .replace(/&quot;/g, '"')
                .replace(/&#039;/g, "'");

    let tvData = null;

    if ( `<%= mediaType %>` == "tv" ) {
        tvData = { season : `<%= season %>`, episode : `<%= episode %>`, epname : ``}
    };

    document.addEventListener("DOMContentLoaded", () => {
        loadWatchPage(`<%= mediaType %>`, name, `<%= id %>`, tvData);
    });
    
</script>

<body>
    <!-- Top Navbar -->
    <%- include('partials/header') %>
    
    <main id="main-content">  
    </main>
</body>
</html>
