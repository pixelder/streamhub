<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>

<script defer>

    const query =  `<%= query %>`.replace(/&amp;/g, '&')
                .replace(/&lt;/g, '<')
                .replace(/&gt;/g, '>')
                .replace(/&quot;/g, '"')
                .replace(/&#039;/g, "'");

    document.addEventListener("DOMContentLoaded", () => {
        getSearchResults(query);
    });
    
</script>

<body>
    <!-- Top Navbar -->
    <%- include('partials/header') %>
    
    <main id="main-content">  
    </main>
</body>
</html>
